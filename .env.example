# --- App ---
NEXT_PUBLIC_APP_NAME=Feeroute
DATABASE_PATH=./data/feeroute.db
# Protects POST /api/cron/claim and /api/admin/*
CRON_SECRET=change-me

# --- Fee economics ---
# Share of every claim sent to the X account (basis points). The rest buys back and burns the protocol token.
RECIPIENT_SHARE_BPS=8000
# A payout is sent each time an account's lifetime earnings cross a milestone (USD).
# Each crossing sends the full unpaid balance. After the last one, every STEP dollars.
PAYOUT_MILESTONES_USD=5,10,20,50,100,250,500,1000
PAYOUT_MILESTONE_STEP_USD=1000

# --- Fee source ---
# "mock" for local development, "longxyz" to read from chain.
FEE_SOURCE=mock

# long.xyz chain settings (only used when FEE_SOURCE=longxyz).
# Check every value below against long.xyz's published contracts before you go live.
LONG_RPC_URL=
LONG_CHAIN_ID=
# Treasury wallet that tokens name as their creator-fee beneficiary.
TREASURY_ADDRESS=
TREASURY_PRIVATE_KEY=
# Contract that holds and releases creator fees.
LONG_FEE_CONTRACT=
# Human-readable ABI signatures (viem parseAbi format).
LONG_LAUNCH_EVENT=event TokenCreated(address indexed token, address indexed creator, string tokenURI)
LONG_CLAIMABLE_FN=function claimable(address token, address beneficiary) view returns (uint256)
LONG_CLAIM_FN=function claim(address token) returns (uint256)
LONG_FROM_BLOCK=0
# Decimals and USD price of the asset fees are paid in (for example, a stock token).
LONG_FEE_ASSET_DECIMALS=18
LONG_FEE_ASSET_USD=1

# --- Payouts ---
# "manual":  payouts stay queued; an operator sends them and marks them paid via the admin API.
# "webhook": each payout is POSTed (HMAC-signed) to your payout service, e.g. one that pays through X Money.
PAYOUT_PROVIDER=manual
PAYOUT_WEBHOOK_URL=
PAYOUT_WEBHOOK_SECRET=

# Optional: function on the token contract that returns its metadata URI (used by /check).
LONG_TOKEN_URI_FN=function tokenURI() view returns (string)

# --- Sign in with X (lets account owners opt out themselves) ---
# Create an OAuth 2.0 app at developer.x.com with callback URL $APP_URL/auth/x/callback.
APP_URL=http://localhost:3000
SESSION_SECRET=generate-a-long-random-string
X_CLIENT_ID=
X_CLIENT_SECRET=

# Profile pictures. Use {handle} as the placeholder; leave empty to show initials only.
NEXT_PUBLIC_AVATAR_URL_TEMPLATE=https://unavatar.io/x/{handle}
